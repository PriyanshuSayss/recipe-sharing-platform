# Environment — Server

# App
NODE_ENV=development
PORT=5000

# MongoDB — replace with your Atlas URI in production
MONGODB_URI=mongodb://localhost:27017/plateful

# JWT — must be at least 32 characters; use a strong random value in production
JWT_SECRET=change-me-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=7d

# CORS — set to your deployed frontend URL in production
CLIENT_ORIGIN=http://localhost:5173

# Cookies
COOKIE_SECURE=false

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Cloudinary (optional — for production image storage)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
