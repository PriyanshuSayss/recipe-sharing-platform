# Plateful Environment Configuration Example
# Copy this file to server/.env for local development

# Runtime Environment
NODE_ENV=development
PORT=5000

# Database Connection
# Local MongoDB instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/plateful

# Authentication / JWT Configuration
# Required: Secure secret key (minimum 32 characters in production)
JWT_SECRET=plateful_super_secure_jwt_secret_key_minimum_32_characters_long_for_dev
JWT_EXPIRES_IN=7d

# CORS & Client URL
# The origin permitted to communicate with the API with credentials
CLIENT_ORIGIN=http://localhost:5173

# Cookie Security
# Set to 'true' in production with HTTPS; set to 'false' for local HTTP development
COOKIE_SECURE=false

# Media Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Optional Cloudinary Storage (for persistent cloud production deployments)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
